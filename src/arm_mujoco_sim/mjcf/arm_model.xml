<mujoco model="mockway_description">
  <include file="scene.xml"/>
  <compiler angle="radian" meshdir="./../meshes" autolimits="true"/>
  <asset>
    <mesh file="base_link.stl" name="base_link_mesh"/>
    <mesh file="link1.stl" name="link1_mesh"/>
    <mesh file="link2.stl" name="link2_mesh"/>
    <mesh file="link3.stl" name="link3_mesh"/>
    <mesh file="link4.stl" name="link4_mesh"/>
    <mesh file="link5.stl" name="link5_mesh"/>
    <mesh file="link6.stl" name="link6_mesh"/>
  </asset>

  <worldbody>
    <!-- Base link (fixed to world) -->
    <body name="base_link" pos="0 0 0" euler="0 0 0">
      <inertial mass="0.097" pos="-0.000 -0.000 0.014" 
                fullinertia="0.000049 0.000049 0.000080 -0.000000 -0.000000 -0.000000"/>
      <geom name="base_link_visual" type="mesh" mesh="base_link_mesh" rgba="0.127 0.301 0.847 1" contype="0" conaffinity="0"/>
      <geom name="base_link_collision" type="mesh" mesh="base_link_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

      <!-- Link 1 (joint1) -->
      <body name="link1" pos="0 0 0.064" euler="0 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" limited="true" range="-6.28 6.28" damping="0.5"/>
        <inertial mass="0.378" pos="0.000 -0.003 -0.005" 
                  fullinertia="0.000195 0.000176 0.000204 -0.000000 -0.000000 0.000005"/>
        <geom name="link1_visual" type="mesh" mesh="link1_mesh" rgba="0.231 0.162 1.000 1" contype="0" conaffinity="0"/>
        <geom name="link1_collision" type="mesh" mesh="link1_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

        <!-- Link 2 (joint2) -->
        <body name="link2" pos="0 0 0" euler="1.571 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" limited="true" range="-6.28 6.28" damping="0.5"/>
          <inertial mass="0.568" pos="0.000 0.035 0.069" 
                    fullinertia="0.002661 0.000305 0.002654 -0.000000 -0.000000 -0.000043"/>
          <geom name="link2_visual" type="mesh" mesh="link2_mesh" rgba="0.031 0.558 0.558 1" contype="0" conaffinity="0"/>
          <geom name="link2_collision" type="mesh" mesh="link2_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

          <!-- Link 3 (joint3) -->
          <body name="link3" pos="0 0.190 0" euler="0 0 0">
            <joint name="joint3" type="hinge" axis="0 0 -1" limited="true" range="-3.14 3.14" damping="0.5"/>
            <inertial mass="0.488" pos="-0.000 0.131 0.006" 
                      fullinertia="0.001818 0.000257 0.001814 0.000000 -0.000000 0.000079"/>
            <geom name="link3_visual" type="mesh" mesh="link3_mesh" rgba="1.000 0.212 0.080 1" contype="0" conaffinity="0"/>
            <geom name="link3_collision" type="mesh" mesh="link3_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

            <!-- Link 4 (joint4) -->
            <body name="link4" pos="0 0.163 0" euler="0 0 0">
              <joint name="joint4" type="hinge" axis="0 0 1" limited="true" range="-6.28 6.28" damping="0.5"/>
              <inertial mass="0.378" pos="0.000 0.005 0.068" 
                        fullinertia="0.000195 0.000204 0.000176 0.000000 -0.000000 -0.000005"/>
              <geom name="link4_visual" type="mesh" mesh="link4_mesh" rgba="0.701 0.162 0.672 1" contype="0" conaffinity="0"/>
              <geom name="link4_collision" type="mesh" mesh="link4_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

              <!-- Link 5 (joint5) -->
              <body name="link5" pos="0 0 0.071" euler="-1.571 0 0">
                <joint name="joint5" type="hinge" axis="0 0 1" limited="true" range="-6.28 6.28" damping="0.5"/>
                <inertial mass="0.378" pos="-0.000 -0.005 0.068" 
                          fullinertia="0.000195 0.000204 0.000176 0.000000 0.000000 0.000005"/>
                <geom name="link5_visual" type="mesh" mesh="link5_mesh" rgba="0.061 0.223 0.456 1" contype="0" conaffinity="0"/>
                <geom name="link5_collision" type="mesh" mesh="link5_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>

                <!-- Link 6 (joint6) -->
                <body name="link6" pos="0 -0.039 0.071" euler="1.571 0 0">
                  <joint name="joint6" type="hinge" axis="0 0 1" limited="true" range="-6.28 6.28" damping="0.5"/>
                  <inertial mass="0.016" pos="0.000 -0.000 -0.004" 
                            fullinertia="0.000003 0.000003 0.000006 0.000000 0.000000 0.000000"/>
                  <geom name="link6_visual" type="mesh" mesh="link6_mesh" rgba="0.527 0.527 0.527 1" contype="0" conaffinity="0"/>
                  <geom name="link6_collision" type="mesh" mesh="link6_mesh" rgba="0 0 0 0" contype="1" conaffinity="1"/>
                  <!-- 末端坐标系 -->
                  <!-- <geom type="sphere" size="0.005" rgba="1 0 0 1" contype="0" conaffinity="0"/> -->
                  <geom type="cylinder" size="0.002 0.025" pos="0.025 0 0" euler="0 1.57 0" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                  <geom type="cylinder" size="0.002 0.025" pos="0 0.025 0" euler="1.57 0 0" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                  <geom type="cylinder" size="0.002 0.025" pos="0 0 0.025" euler="0 0 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="joint1_motor" joint="joint1" gear="1.0" ctrlrange="-21 21"/>
    <motor name="joint2_motor" joint="joint2" gear="1.0" ctrlrange="-21 21"/>
    <motor name="joint3_motor" joint="joint3" gear="1.0" ctrlrange="-21 21"/>
    <motor name="joint4_motor" joint="joint4" gear="1.0" ctrlrange="-10 10"/>
    <motor name="joint5_motor" joint="joint5" gear="1.0" ctrlrange="-10 10"/>
    <motor name="joint6_motor" joint="joint6" gear="1.0" ctrlrange="-10 10"/>
  </actuator>
</mujoco>